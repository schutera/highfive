# HighFive — development environment variables
#
# Copy to .env at the repo root, then `docker compose up --build`:
#     cp .env.example .env
#
# This file is the ONE description of the dev .env. CONTRIBUTING.md,
# CLAUDE.md, AGENTS.md, docs/07-deployment-view/docker-compose.md,
# docs/troubleshooting.md and the esp32-onboarding skill (both mirrors) all
# point here rather than restating it, so there is nothing to drift out of
# sync.
#
# Deploying? This is the wrong file, and which one is right depends on the
# topology (docs/07-deployment-view/what-is-live.md says which is live):
#   - Live host (PM2): the server-side .env, .deploy.env and
#     ecosystem.config.js described in production-runbook.md.
#   - Docker production target (supported, not deployed): copy
#     .env.production.example to .env.production, which
#     docker-compose.prod.yml is given with `--env-file`.
#
# NEVER commit your .env.

# Flask debug mode in image-service and duckdb-service. It is passed to
# `app.run(..., debug=debug, use_debugger=False)` in the `__main__` blocks of
# image-service/app.py and duckdb-service/app.py, so `true` turns on the
# auto-reloader only: the Werkzeug interactive debugger stays off either way
# (#235). Keep it false under compose, which does not bind-mount the Python
# sources, so the reloader has nothing to reload.
#
# Optional: both services default to false when unset.
DEBUG=false

# Where image-service reaches the DuckDB service. Optional — image-service
# defaults to this exact value (the Docker service name), and in compose the
# backend is given it by docker-compose.yml's `environment:` block rather than
# by this file. The backend's own code default is different on purpose: it is
# the host-side http://127.0.0.1:8002, for a backend run outside compose with
# `npm run dev`. Only set this yourself if you run the services outside
# compose.
DUCKDB_SERVICE_URL=http://duckdb-service:8000

# Discord webhook for alert delivery. Optional — docker-compose.yml passes it
# through as `${DISCORD_WEBHOOK_URL:-}`, so leaving it unset disables the
# notification rather than failing. Uncomment to receive alerts in dev.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Admin secret: the /admin login password, and the HMAC key for the session
# cookie (#142 / ADR-019). image-service and duckdb-service also read it for
# their /logs gates, so a custom value must be the same for all three
# services. Never shipped to the browser; rotating it invalidates outstanding
# sessions.
#
# Optional in dev — leaving it unset uses the dev fallback 'hf_dev_key_2026'.
# Set it if you want a password of your own:
#     openssl rand -base64 32
# HIGHFIVE_API_KEY=your-strong-key
#
# There is deliberately no VITE_* form of this. A VITE_-prefixed variable is
# inlined into the browser bundle, which is how the admin key leaked in #142;
# ADR-019 moved it server-side. Do not reintroduce one.
