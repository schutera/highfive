# HighFive — development environment variables
#
# Copy to .env at the repo root, then `docker compose up --build`:
#     cp .env.example .env
#
# This file is the ONE description of the dev .env. CONTRIBUTING.md,
# CLAUDE.md and docs/07-deployment-view/docker-compose.md all point here
# rather than restating it, so there is nothing to drift out of sync.
#
# Deploying? This is the wrong file — see .env.production.example, which
# is what docker-compose.prod.yml consumes.
#
# NEVER commit your .env.

# Verbose logging in the two Flask services (image-service, duckdb-service).
# Optional: both default to false when unset.
DEBUG=true

# Where image-service reaches the DuckDB service. Optional — image-service
# defaults to this exact value (the Docker service name), and in compose the
# backend is given it by docker-compose.yml's `environment:` block rather than
# by this file. The backend's own code default is different on purpose: it is
# the host-side http://127.0.0.1:8002, for a backend run outside compose with
# `npm run dev`. Only set this yourself if you run the services outside
# compose.
DUCKDB_SERVICE_URL=http://duckdb-service:8000

# Discord webhook for alert delivery. Optional — docker-compose.yml passes it
# through as `${DISCORD_WEBHOOK_URL:-}`, so leaving it unset disables the
# notification rather than failing. Uncomment to receive alerts in dev.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Admin secret: the /admin login password, and the HMAC key for the session
# cookie (#142 / ADR-019). Never shipped to the browser; rotating it
# invalidates outstanding sessions.
#
# Optional in dev — leaving it unset uses the dev fallback 'hf_dev_key_2026'.
# Set it if you want a password of your own:
#     openssl rand -base64 32
# HIGHFIVE_API_KEY=your-strong-key
#
# There is deliberately no VITE_* form of this. A VITE_-prefixed variable is
# inlined into the browser bundle, which is how the admin key leaked in #142;
# ADR-019 moved it server-side. Do not reintroduce one.
