# HighFive Development Environment Variables
# Copy this file to .env and edit if needed
# NEVER commit the .env file to version control!

# Admin secret (login password + session-cookie HMAC key; #142 / ADR-019).
# For local dev, any non-empty string works.
HIGHFIVE_API_KEY=dev-secret-key

# API URL (used by frontend)
# Leave empty for local dev — defaults to http://localhost:3002/api
VITE_API_URL=

# Node environment
NODE_ENV=development

# Backend port (internal)
PORT=3001

# Debug mode
DEBUG=true

# DuckDB service URL
DUCKDB_SERVICE_URL=http://localhost:5001
