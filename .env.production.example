# Production environment for docker-compose.prod.yml
# Copy this to .env.production, fill in the secrets, and run:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# `docker compose` will FAIL FAST if HIGHFIVE_API_KEY is unset or empty.
# This is by design - it replaces the silent dev-key fallback that
# shipped before fix/prod-stack-secrets-and-topology (#37).
# NOTE: DISCORD_WEBHOOK_URL below is the exception - it is interpolated as
# ${DISCORD_WEBHOOK_URL:-} so the stack boots without it. Read its comment;
# leaving it blank silently disables the ADR-005 silence watcher.

# Admin secret. Generate with: openssl rand -base64 32
# This is the admin LOGIN PASSWORD (POST /api/admin/login) and the HMAC key
# that signs admin session cookies. Rotating it invalidates outstanding
# sessions. It is NEVER shipped to the browser (#142 / ADR-019).
HIGHFIVE_API_KEY=

# NOTE: VITE_API_KEY was removed (#142). The homepage bundle no longer carries
# any secret — a single-page app cannot hold one. Reads are public; admin
# actions authenticate via the server-side session cookie above.

# Discord webhook for operational alerts. OPTIONAL in the sense that the stack
# boots without it (it is `${DISCORD_WEBHOOK_URL:-}` in docker-compose.prod.yml,
# not `:?`), but leaving it blank has a consequence worth stating plainly:
#
#   *** THE SILENCE WATCHER GOES DARK. ***
#
# duckdb-service's ADR-005 silence watcher posts module-down and recovery
# alerts through this webhook — it is the operator's primary signal that a
# field module stopped reporting. Unset, `send_discord_message` degrades to a
# print() nobody reads, and a dead module looks identical to a healthy one
# until someone opens the dashboard.
#
# It is blank here rather than hardcoded because the 2026-07 audit (#201)
# removed a webhook URL that was baked into the source of both Python
# services — a live credential in a public repo. Paste your own:
DISCORD_WEBHOOK_URL=
