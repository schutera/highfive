#!/usr/bin/env sh
# Verify that path:line citations in docs/ and CLAUDE.md still point at
# the content the doc claims they do. Catches the line-number drift
# documented in docs/11-risks-and-technical-debt/ ("Drift sweep is not
# a substitute for a CI check"). Exits non-zero on missing files or
# past-EOF citations; warns (without failing) on blank-line landings
# so legitimate "quoted past mistake" examples in lessons-learned don't
# block the push.
bash scripts/check-doc-citations.sh || exit 1

# Catch broken pre-#40 factory-reset prose ("hold IO0 / the left button
# for N seconds") regressing in user-facing surfaces. See
# docs/11-risks-and-technical-debt/README.md "GPIO0 is a strap pin".
bash scripts/check-stale-reset-prose.sh || exit 1

# Catch the deprecated `displayName ?? name` rule re-emerging in prose
# or code outside its legitimate allow-list. The label resolves via
# `homepage/src/lib/displayLabel.ts` (.trim() || name); `??` only
# short-circuits on null, missing the empty-string defense. See
# docs/11-risks-and-technical-debt/README.md
# "`displayName ?? name` lived in seven docs and eight render sites".
bash scripts/check-stale-display-name-rule.sh || exit 1

# Catch a hardcoded Google API key, Discord webhook, or WiFi.begin()
# Wi-Fi credential literal — the failure modes of issue #18 and issue
# #227. See docs/11-risks-and-technical-debt/README.md
# "Third-party API keys belong in build-time macros, not source".
bash scripts/check-no-hardcoded-api-keys.sh || exit 1
bash scripts/check-duckdb-bind-claims.sh || exit 1

# Catch the Python runtime version drifting apart again across the
# Dockerfiles, ruff floor, and CI matrices — the root cause of #180.
# /.python-version is the single source of truth. See
# docs/11-risks-and-technical-debt/README.md "CI tested only Python 3.11".
bash scripts/check-python-version.sh || exit 1

# Catch the hand-duplicated image-service/duckdb-service Python twins
# (log_ring, prod_guard, module_id, discord, test_prod_guard) drifting
# apart with nothing to notice — exactly what happened to the discord.py
# twin before this gate existed (#241). See
# docs/11-risks-and-technical-debt/README.md for the twin-file relationship.
bash scripts/check-python-twins.sh || exit 1
